#include "BuildIdentity.hpp"

#include "MultiplayerProtocol.hpp"

#include <sstream>

#ifndef DB_BUILD_CONFIGURATION
#define DB_BUILD_CONFIGURATION "unknown"
#endif
#ifndef DB_STOREFRONT_RELEASE
#define DB_STOREFRONT_RELEASE 0
#endif
#ifndef DB_ENABLE_DEVELOPER_CONSOLE
#define DB_ENABLE_DEVELOPER_CONSOLE 0
#endif

const BuildIdentity& desktopBuildIdentity() {
    static const BuildIdentity identity{
        "@DB_HUMAN_VERSION@",
        "@DB_COMMIT_SHA@",
        "@DB_COMMIT_SHORT@",
        dbnet::PROTOCOL_VERSION,
        dbnet::GAMEPLAY_VERSION,
        @DB_SAVE_FORMAT_VERSION@,
        "@DB_PLATFORM@",
        "@DB_ARCHITECTURE@",
        DB_BUILD_CONFIGURATION,
        "@DB_BUILD_TIME@",
        "@DB_CHANNEL@",
        DB_STOREFRONT_RELEASE != 0,
        DB_ENABLE_DEVELOPER_CONSOLE != 0
    };
    return identity;
}

std::string desktopBuildIdentityLine() {
    const BuildIdentity& identity = desktopBuildIdentity();
    std::ostringstream out;
    out << identity.humanVersion
        << " " << identity.commitShort
        << " " << identity.platform << "/" << identity.architecture
        << " protocol " << identity.protocolVersion
        << " gameplay " << identity.gameplayVersion
        << " save " << identity.saveFormatVersion
        << (identity.storefrontRelease ? " storefront/solo" : " development")
        << (identity.developerConsole ? " dev-console" : "");
    return out.str();
}
