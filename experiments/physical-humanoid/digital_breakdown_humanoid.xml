<mujoco model="digital_breakdown_physical_human">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.0041666667" gravity="0 0 -9.81" integrator="implicitfast">
    <flag contact="enable"/>
  </option>
  <visual>
    <global offwidth="960" offheight="540"/>
  </visual>

  <default>
    <joint damping="1.3" armature="0.025" frictionloss="0.08"/>
    <geom condim="3" friction="1.1 0.02 0.002" density="720"
          solref="0.012 1" solimp="0.9 0.95 0.002"/>
    <position ctrllimited="true" ctrlrange="-1 1" forcelimited="true"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.16 0.18 0.20" rgb2="0.02 0.025 0.03" width="512" height="3072"/>
    <material name="skin" rgba="0.34 0.38 0.39 1" roughness="0.72"/>
    <material name="joint" rgba="0.10 0.75 0.68 1" emission="0.08"/>
    <material name="floor" rgba="0.12 0.14 0.15 1" roughness="0.9"/>
  </asset>

  <worldbody>
    <light pos="-2 -3 5" dir="0.3 0.45 -1" diffuse="0.9 0.86 0.76" castshadow="true"/>
    <light pos="3 2 2" dir="-0.5 -0.2 -0.5" diffuse="0.22 0.35 0.42"/>
    <geom name="ground" type="plane" size="12 12 0.1" material="floor"/>
    <site name="desired_target" pos="3 0 0.03" size="0.06" rgba="0.15 0.85 0.65 1"/>

    <body name="pelvis" pos="0 0 1.02">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="capsule" fromto="0 -0.13 0 0 0.13 0" size="0.105" material="skin"/>
      <site name="pelvis_imu" size="0.015"/>

      <body name="torso" pos="0 0 0.10">
        <joint name="abdomen_pitch" axis="0 1 0" range="-0.55 0.55"/>
        <joint name="abdomen_roll" axis="1 0 0" range="-0.42 0.42"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.39" size="0.13" material="skin"/>
        <body name="head" pos="0 0 0.48">
          <joint name="neck_pitch" axis="0 1 0" range="-0.45 0.45"/>
          <geom type="sphere" size="0.115" material="skin"/>
        </body>

        <body name="left_upper_arm" pos="0 0.17 0.33">
          <joint name="left_shoulder_pitch" axis="0 1 0" range="-1.7 1.7"/>
          <joint name="left_shoulder_roll" axis="1 0 0" range="-1.2 1.2"/>
          <geom type="capsule" fromto="0 0 0 0 0.25 -0.03" size="0.047" material="skin"/>
          <body name="left_forearm" pos="0 0.25 -0.03">
            <joint name="left_elbow" axis="0 1 0" range="-1.9 0.1"/>
            <geom type="capsule" fromto="0 0 0 0 0.23 -0.02" size="0.04" material="skin"/>
          </body>
        </body>
        <body name="right_upper_arm" pos="0 -0.17 0.33">
          <joint name="right_shoulder_pitch" axis="0 1 0" range="-1.7 1.7"/>
          <joint name="right_shoulder_roll" axis="1 0 0" range="-1.2 1.2"/>
          <geom type="capsule" fromto="0 0 0 0 -0.25 -0.03" size="0.047" material="skin"/>
          <body name="right_forearm" pos="0 -0.25 -0.03">
            <joint name="right_elbow" axis="0 1 0" range="-1.9 0.1"/>
            <geom type="capsule" fromto="0 0 0 0 -0.23 -0.02" size="0.04" material="skin"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.105 -0.08">
        <joint name="left_hip_pitch" axis="0 1 0" range="-1.1 1.1"/>
        <joint name="left_hip_roll" axis="1 0 0" range="-0.55 0.55"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.36" size="0.068" material="skin"/>
        <body name="left_shin" pos="0 0 -0.36">
          <joint name="left_knee" axis="0 1 0" range="-0.05 2.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.35" size="0.057" material="skin"/>
          <body name="left_foot" pos="0 0 -0.35">
            <joint name="left_ankle_pitch" axis="0 1 0" range="-0.65 0.65"/>
            <joint name="left_ankle_roll" axis="1 0 0" range="-0.35 0.35"/>
            <geom name="left_foot_geom" type="box" pos="0.025 0 -0.025" size="0.17 0.068 0.035" material="joint"/>
            <site name="left_foot_contact" pos="0.025 0 -0.061" size="0.03"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.105 -0.08">
        <joint name="right_hip_pitch" axis="0 1 0" range="-1.1 1.1"/>
        <joint name="right_hip_roll" axis="1 0 0" range="-0.55 0.55"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.36" size="0.068" material="skin"/>
        <body name="right_shin" pos="0 0 -0.36">
          <joint name="right_knee" axis="0 1 0" range="-0.05 2.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.35" size="0.057" material="skin"/>
          <body name="right_foot" pos="0 0 -0.35">
            <joint name="right_ankle_pitch" axis="0 1 0" range="-0.65 0.65"/>
            <joint name="right_ankle_roll" axis="1 0 0" range="-0.35 0.35"/>
            <geom name="right_foot_geom" type="box" pos="0.025 0 -0.025" size="0.17 0.068 0.035" material="joint"/>
            <site name="right_foot_contact" pos="0.025 0 -0.061" size="0.03"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="pelvis" body2="torso"/>
    <exclude body1="left_thigh" body2="left_shin"/>
    <exclude body1="right_thigh" body2="right_shin"/>
  </contact>

  <actuator>
    <position name="abdomen_pitch_motor" joint="abdomen_pitch" kp="160" ctrlrange="-0.45 0.45" forcerange="-110 110"/>
    <position name="abdomen_roll_motor" joint="abdomen_roll" kp="160" ctrlrange="-0.35 0.35" forcerange="-110 110"/>
    <position name="neck_motor" joint="neck_pitch" kp="35" ctrlrange="-0.35 0.35" forcerange="-18 18"/>
    <position name="left_shoulder_pitch_motor" joint="left_shoulder_pitch" kp="35" forcerange="-28 28"/>
    <position name="left_shoulder_roll_motor" joint="left_shoulder_roll" kp="30" forcerange="-24 24"/>
    <position name="left_elbow_motor" joint="left_elbow" kp="24" forcerange="-18 18"/>
    <position name="right_shoulder_pitch_motor" joint="right_shoulder_pitch" kp="35" forcerange="-28 28"/>
    <position name="right_shoulder_roll_motor" joint="right_shoulder_roll" kp="30" forcerange="-24 24"/>
    <position name="right_elbow_motor" joint="right_elbow" kp="24" forcerange="-18 18"/>
    <position name="left_hip_pitch_motor" joint="left_hip_pitch" kp="190" forcerange="-150 150"/>
    <position name="left_hip_roll_motor" joint="left_hip_roll" kp="170" forcerange="-130 130"/>
    <position name="left_knee_motor" joint="left_knee" kp="210" forcerange="-160 160"/>
    <position name="left_ankle_pitch_motor" joint="left_ankle_pitch" kp="130" forcerange="-95 95"/>
    <position name="left_ankle_roll_motor" joint="left_ankle_roll" kp="120" forcerange="-85 85"/>
    <position name="right_hip_pitch_motor" joint="right_hip_pitch" kp="190" forcerange="-150 150"/>
    <position name="right_hip_roll_motor" joint="right_hip_roll" kp="170" forcerange="-130 130"/>
    <position name="right_knee_motor" joint="right_knee" kp="210" forcerange="-160 160"/>
    <position name="right_ankle_pitch_motor" joint="right_ankle_pitch" kp="130" forcerange="-95 95"/>
    <position name="right_ankle_roll_motor" joint="right_ankle_roll" kp="120" forcerange="-85 85"/>
  </actuator>

  <sensor>
    <framequat name="pelvis_orientation" objtype="site" objname="pelvis_imu"/>
    <gyro name="pelvis_angular_velocity" site="pelvis_imu"/>
    <velocimeter name="pelvis_velocity" site="pelvis_imu"/>
    <touch name="left_foot_touch" site="left_foot_contact"/>
    <touch name="right_foot_touch" site="right_foot_contact"/>
  </sensor>
</mujoco>
