{
  "schemaVersion": 1,
  "id": "indrolend/data",
  "name": "DATA",
  "displayName": "Digital Breakdown",
  "creator": "indrolend",
  "aliases": [
    "DATA",
    "Digital Breakdown",
    "DigitalBreakdown"
  ],
  "repository": "indrolend/digital-breakdown-apk",
  "publicDistributionRepository": "indrolend/Digital-breakdown-dev",
  "channel": "latest-native",
  "manifest": "https://github.com/indrolend/Digital-breakdown-dev/releases/download/latest-native/build-manifest.json",
  "channels": {
    "latest-native": "Canonical downloadable native desktop application artifacts"
  },
  "developmentRepository": "indrolend/Digital-breakdown-dev",
  "commandHud": {
    "commands": [
      {
        "name": "play",
        "action": "Play",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dbdev.ps1 playtest -Mode game",
        "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/dbdev.ps1", "playtest", "-Mode", "game"],
        "owner": "tools/dbdev.ps1",
        "kind": "smoke",
        "successMarkers": [
          {"contains": "PLAYTEST_READY mode=game", "summary": "desktop game launched"}
        ]
      },
      {
        "name": "verify",
        "action": "Ship",
        "command": "node tools/verify.mjs",
        "argv": ["node", "tools/verify.mjs"],
        "owner": "tools/verify.mjs",
        "kind": "test",
        "resultMarkers": true,
        "stageMarker": "DATA_VERIFY_STAGE",
        "stages": [
          {
            "name": "hud:check",
            "paths": [
              "distribution/project.json",
              "package.json",
              "package-lock.json",
              "CommandHUD.cmd",
              "CommandHUD Shell.cmd",
              "tools/commandhud-project.test.mjs",
              "tools/verify.mjs",
              "tools/verify.test.mjs",
              "tools/lint.mjs",
              "tools/run-native-tests.mjs",
              "tools/verify_assets.py",
              "scripts/verify-gameplay.ps1",
              "scripts/verify-gameplay.sh",
              "multiplayer-server/package.json"
            ]
          },
          {
            "name": "lint",
            "paths": ["."]
          },
          {
            "name": "assets",
            "paths": [
              "distribution/project.json",
              "package.json",
              "tools/verify.mjs",
              "tools/verify_assets.py",
              "native-models",
              "native-desktop/audio"
            ]
          },
          {
            "name": "test",
            "paths": [
              "distribution/project.json",
              "package.json",
              "tools/verify.mjs",
              "tools/run-native-tests.mjs",
              "scripts/verify-gameplay.ps1",
              "scripts/verify-gameplay.sh",
              "native",
              "native-desktop",
              "native-network"
            ]
          },
          {
            "name": "multiplayer",
            "paths": [
              "distribution/project.json",
              "package.json",
              "tools/verify.mjs",
              "multiplayer-server",
              "native-network"
            ]
          }
        ]
      },
      {
        "name": "lint",
        "command": "node tools/lint.mjs",
        "argv": ["node", "tools/lint.mjs"],
        "owner": "tools/lint.mjs",
        "kind": "lint",
        "resultMarkers": true
      },
      {
        "name": "assets",
        "command": "python tools/verify_assets.py",
        "argv": ["python", "tools/verify_assets.py"],
        "owner": "tools/verify_assets.py",
        "resultMarkers": true,
        "successMarkers": [
          {"contains": "ASSETS=PASS", "summary": "native runtime assets"}
        ]
      },
      {
        "name": "native-tests",
        "command": "node tools/run-native-tests.mjs",
        "argv": ["node", "tools/run-native-tests.mjs"],
        "owner": "tools/run-native-tests.mjs",
        "kind": "test",
        "resultMarkers": true
      },
      {
        "name": "traversal-check",
        "action": "Check",
        "command": "node tools/run-traversal-tier.mjs check",
        "argv": ["node", "tools/run-traversal-tier.mjs", "check"],
        "owner": "tools/run-traversal-tier.mjs",
        "kind": "test",
        "resultMarkers": true,
        "successMarkers": [
          {"contains": "TRAVERSAL=PASS mode=check", "summary": "fast traversal check"}
        ]
      },
      {
        "name": "traversal-prove",
        "action": "Prove",
        "command": "node tools/run-traversal-tier.mjs prove",
        "argv": ["node", "tools/run-traversal-tier.mjs", "prove"],
        "owner": "tools/run-traversal-tier.mjs",
        "kind": "test",
        "resultMarkers": true,
        "successMarkers": [
          {"contains": "TRAVERSAL=PASS mode=prove", "summary": "exhaustive traversal proof"}
        ]
      },
      {
        "name": "traversal-mutate",
        "action": "Explore",
        "command": "node tools/run-traversal-mutation-gauntlet.mjs",
        "argv": ["node", "tools/run-traversal-mutation-gauntlet.mjs"],
        "owner": "tools/run-traversal-mutation-gauntlet.mjs",
        "kind": "test",
        "resultMarkers": true,
        "successMarkers": [
          {"contains": "MUTATION_GAUNTLET=PASS", "summary": "seeded traversal fault gauntlet"}
        ]
      },
      {
        "name": "multiplayer",
        "command": "npm --prefix multiplayer-server run check",
        "argv": ["npm", "--prefix", "multiplayer-server", "run", "check"],
        "owner": "multiplayer-server/package.json",
        "kind": "test",
        "resultMarkers": true
      },
      {
        "name": "multiplayer-dry-deploy",
        "command": "npm --prefix multiplayer-server run deploy:dry",
        "argv": ["npm", "--prefix", "multiplayer-server", "run", "deploy:dry"],
        "owner": "multiplayer-server/package.json"
      }
    ]
  }
}
