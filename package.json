{
  "name": "digital-breakdown",
  "version": "1.0.0",
  "description": "Experimental cross-platform action game and multiplayer relay",
  "main": "index.js",
  "scripts": {
    "hud:check": "node --test ./tools/commandhud-project.test.mjs",
    "lint": "node ./tools/lint.mjs",
    "menu": "node ./tools/dev-menu.mjs",
    "build:web": "esbuild ./www/android-entry.mjs --bundle --platform=browser --format=iife --target=chrome61 --outfile=./www/android-bundle.js --log-level=info",
    "cap:sync": "cap sync android",
    "android:build:mac": "./scripts/build-android.sh",
    "android:install:mac": "./scripts/install-android.sh",
    "android:run:mac": "./scripts/build-android.sh && ./scripts/install-android.sh",
    "test": "node ./tools/run-native-tests.mjs",
    "repo:clean": "./scripts/clean.sh",
    "logs:janitor": "./scripts/clean.sh logs",
    "android:postboot": "./scripts/status-android.sh",
    "android:live-debug": "./scripts/live-android-debug.sh",
    "lg:probe": "./scripts/probe-lg.sh adb",
    "lg:fastboot": "./scripts/probe-lg.sh fastboot",
    "lg:download": "./scripts/probe-lg.sh download",
    "lg:full": "./scripts/probe-lg.sh full",
    "android:status": "./scripts/status-android.sh",
    "android:postboot:verbose": "./scripts/postboot-status.sh",
    "android:cycle": "./scripts/run-cycle.sh android-cycle",
    "android:test-cycle": "./scripts/run-cycle.sh test-cycle",
    "android:posttest": "./scripts/run-cycle.sh posttest",
    "lg:diagnose": "./scripts/run-cycle.sh diagnose",
    "lg:fastboot-cycle": "./scripts/run-cycle.sh fastboot-cycle",
    "lg:download-note": "./scripts/run-cycle.sh download-note",
    "lg:probe:verbose": "./scripts/probe-lg.sh adb --verbose",
    "lg:fastboot:verbose": "./scripts/probe-lg.sh fastboot --verbose",
    "checkpoint": "./scripts/checkpoint.sh",
    "android:mirror": "./scripts/mirror-android.sh",
    "android:demo-cycle": "./scripts/build-android.sh && ./scripts/install-android.sh && ./scripts/mirror-android.sh --no-launch",
    "android:demo-window": "./scripts/android.sh demo-window",
    "android": "./scripts/android.sh",
    "android:test": "./scripts/android.sh test",
    "android:demo": "./scripts/android.sh demo",
    "android:logs": "./scripts/android.sh logs",
    "native": "bash ./scripts/native-android.sh",
    "native:build": "bash ./scripts/native-android.sh build",
    "native:install": "bash ./scripts/native-android.sh install",
    "native:launch": "bash ./scripts/native-android.sh launch",
    "native:test": "bash ./scripts/native-android.sh test",
    "native:status": "bash ./scripts/native-android.sh status",
    "native:screenshot": "bash ./scripts/native-android.sh screenshot",
    "native:watch-artifacts": "bash ./scripts/watch-native-artifacts.sh"
  },
  "keywords": [],
  "author": "Joel Gutierrez and contributors",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
